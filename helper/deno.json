{
  "version": "0.1.0",
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-write --allow-run --allow-env --allow-sys --unstable-worker-options src/main.ts --no-open",
    "test": "deno test --allow-read --allow-env --allow-write --allow-run src/",
    "check": "deno check src/main.ts scripts/build.ts",
    "build": "deno run --allow-read --allow-write --allow-run --allow-env scripts/build.ts"
  },
  "compilerOptions": {
    "strict": true
  },
  "lock": false
}
