# Public address of the "add a song" Cloudflare relay (not a secret; the GitHub
# token lives inside the Worker). With this set, the app never shows the
# "Connect to GitHub" step. The deploy workflow overrides it with the
# ADD_SONG_URL repository variable when that is set.
VITE_ADD_SONG_URL=https://dancedance-add-song.ryee.workers.dev
